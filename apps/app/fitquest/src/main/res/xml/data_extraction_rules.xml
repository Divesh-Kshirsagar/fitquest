<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local Room database containing GPS / movement history from unencrypted cloud backup -->
        <exclude domain="database" path="fitquest.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fitquest.db" />
    </device-transfer>
</data-extraction-rules>